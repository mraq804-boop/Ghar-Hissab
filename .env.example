# Copy to .env.local for development. In Vercel, set the same names under
# Project Settings -> Environment Variables. Never commit real values.

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public URL of the app (used in sign-in links and the Google redirect URI)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the scheduled sync endpoint (/api/sync/run). 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# Google Sheets sync (Google Cloud OAuth client, see docs/EXCEL_SYNC.md)
GOOGLE_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-client-secret
# 32 random bytes, base64. Encrypts the stored Google refresh token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EXCEL_TOKEN_ENC_KEY=replace-with-32-random-bytes-base64=
